{
  "expo": {
    "name": "SquarFT",
    "slug": "squarft-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon.png",
    "scheme": "squarftuser",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "owner": "squarft-team",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squarft.user",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow SquarFT to use your camera for video calls and property media.",
        "NSMicrophoneUsageDescription": "Allow SquarFT to use your microphone for AI voice and video calls.",
        "NSLocationWhenInUseUsageDescription": "Allow SquarFT to use your location to show nearby projects."
      },
      "bitcode": false
    },
    "android": {
      "googleServicesFile": "./app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.squarft.user",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDiYnY4FG1juihWvHEgM-NSz2aEKUsKing"
        }
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#4A43EC",
          "defaultChannel": "customer-offers"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/icon.png",
          "resizeMode": "cover",
          "imageWidth": 200,
          "backgroundColor": "#4A43EC",
          "dark": {
            "backgroundColor": "#4A43EC"
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow SquarFT to use your microphone for AI voice calls."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SquarFT to use your location to show nearby projects."
        }
      ],
      "expo-font"
    ],
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "cover",
      "imageWidth": 200,
      "backgroundColor": "#4A43EC",
      "dark": {
        "backgroundColor": "#4A43EC"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyDiYnY4FG1juihWvHEgM-NSz2aEKUsKing",
      "eas": {
        "projectId": "82b2ad3e-48ad-4c46-8af9-f319a0ed9905"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/82b2ad3e-48ad-4c46-8af9-f319a0ed9905"
    }
  }
}
